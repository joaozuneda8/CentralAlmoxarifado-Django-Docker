# Chave secreta do Django (obrigatória com DEBUG=0). Gere com:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# 1 só no computador de desenvolvimento; 0 no servidor.
DEBUG=1
# Nomes pelos quais o site é acessado, separados por vírgula (ex.: almoxarifado.saep.local).
ALLOWED_HOSTS=
# Origens confiáveis para formulários, com esquema (ex.: https://almoxarifado.saep.local).
CSRF_TRUSTED_ORIGINS=
# 1 quando o site é servido por HTTPS (cookies seguros, redirecionamento e HSTS).
USAR_HTTPS=1
# 1 quando o HTTPS termina num proxy (Apache) que envia X-Forwarded-Proto. O waitress
# precisa confiar nesse cabeçalho, senão o descarta e a página entra em laço de
# redirecionamento. O X-Forwarded-For traz o IP real de quem pede: sem ele, todo pedido
# parece vir do Apache e os formulários dividem um único limite por IP. Rode com
#   --trusted-proxy=127.0.0.1 --trusted-proxy-headers="x-forwarded-proto x-forwarded-for"
PROXY_HTTPS=0
# Prefixo do site atrás do Apache, igual ao --url-prefix do waitress (ex.: /almoxarifado).
# Vazio = o site na raiz.
PREFIXO_URL=
# Banco MySQL/MariaDB próprio do sistema.
DB_NAME=almoxarifado
DB_USER=almox
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Usuário e senha do SCPI usados pelos robôs.
SAEP_USER=
SAEP_PASS=
# Endereço do SCPI, sempre https:// (vazio = https://transparencia.saep.sp.gov.br:8445/scpi9/).
SCPI_URL=
# 1 abre o navegador dos robôs sem janela (necessário rodando como serviço do Windows).
SCPI_HEADLESS=0
# Pasta do perfil do navegador dos robôs (vazio = .pw-profile/ na raiz do projeto).
SCPI_PERFIL_DIR=
# Pasta do Chromium do Playwright, comum ao serviço e às tarefas agendadas (vazio = a pasta do
# usuário que rodou "playwright install"). Instale com a mesma variável definida no terminal.
PLAYWRIGHT_BROWSERS_PATH=
# 1 libera o lançamento real no SCPI. Fica 0 no período em paralelo com o Apps Script
# (só a simulação roda) e vira 1 na virada (deploy/VIRADA.md).
LANCAMENTO_REAL=0
# Bot e chat do Telegram que recebem o aviso de novo pedido.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Pasta dos logs (vazio = logs/ na raiz do projeto).
LOG_DIR=
# Pasta dos backups diários do banco, fora do repositório (vazio = ..\backups-almoxarifado).
BACKUP_DIR=
# Programa do dump: mysqldump (MySQL) ou mariadb-dump (MariaDB), com o caminho se não estiver no PATH.
MYSQLDUMP=
